# Домен (для sitemap та canonical)
NEXT_PUBLIC_SITE_URL=https://oliynyk-mebli.ua

# Telegram сповіщення (необов'язково)
# 1) Створіть бота через @BotFather — отримайте токен
# 2) Дізнайтесь chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
