# ── Admin ────────────────────────────────────────────────────────────────────
# Password to access /admin panel (default: admin1234 if not set)
ADMIN_PASSWORD=your_secure_password_here

# ── Telegram Notifications (optional) ────────────────────────────────────────
# Get bot token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudinary (optional, for image uploads) ─────────────────────────────────
# Sign up at cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Database (optional, future migration to PostgreSQL) ──────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/oliynyk
